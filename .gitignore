# Dependencies
node_modules/
.npm

# Build outputs
dist/
out-tsc/
.angular/
coverage/

# Variables de entorno (contienen secretos). Solo se versiona el ejemplo.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.compartida.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Caché del compilador de TypeScript
*.tsbuildinfo

# Prisma
backend/node_modules/.prisma/

# Angular cache
.angular/cache/

# Herramientas de IA (configuración personal; el contrato es AGENTS.md)
.claude/settings.local.json
.kiro/
.opencode/

# Compilados de la carga de arranque (se ejecuta seed.ts con ts-node)
backend/prisma/*.js
backend/prisma/*.js.map
backend/prisma/*.d.ts

# Respaldos de la base (contienen datos; se guardan solo en la máquina del responsable)
backups/

# Respaldos y volcados de base sueltos
*.dump
*.sql.gz

# Ajustes locales de Docker de cada integrante
docker-compose.override.yml

# Llaves y certificados locales
*.pem
*.key

.agents/tasks/
