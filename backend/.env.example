# AeroCRM — variables del backend. Copia este archivo a .env y completa los valores.
# .env nunca se versiona (AGENTS.md D4). Toda variable nueva se agrega aquí con su comentario.

# ── Base de datos (AGENTS.md D2 y D3) ─────────────────────────────────────────
# Los valores están en la página de Accesos del equipo (ver docs/ACCESOS.md).
# El equipo usa el usuario aerocrm_equipo; solo quien aplica migraciones usa postgres (AGENTS.md G4).
# Conexión de trabajo: pooler de transacciones (puerto 6543).
# connection_limit=3 evita que seis máquinas encendidas agoten las conexiones del plan gratuito.
DATABASE_URL="postgresql://aerocrm_equipo.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true&connection_limit=3"
# Conexión para aplicar migraciones: pooler de sesión (puerto 5432).
# Prisma la exige; con aerocrm_equipo no sirve para migrar, a propósito.
DIRECT_URL="postgresql://aerocrm_equipo.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres"
# Base local en contenedor (docker-compose.local.yml): usa estas dos líneas en lugar de las anteriores.
# DATABASE_URL="postgresql://aerocrm:aerocrm@localhost:5433/aerocrm"
# DIRECT_URL="postgresql://aerocrm:aerocrm@localhost:5433/aerocrm"

# ── Autenticación ─────────────────────────────────────────────────────────────
# Cadena larga y aleatoria. Todo el equipo usa la misma para compartir sesiones contra la base compartida.
JWT_SECRET="<VALOR-DE-LA-PAGINA-DE-ACCESOS>"
# Duración del token de sesión.
JWT_EXPIRES_IN="24h"

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000

# ── Datos de arranque ─────────────────────────────────────────────────────────
# Fecha de referencia para las fechas de vuelos de la carga de arranque (AAAA-MM-DD).
# Vacía = el día en que se ejecuta. Fíjala antes de la sustentación para que los datos no cambien.
SEED_REFERENCE_DATE=""

# ── APIs externas (opcionales: sin clave se usan los datos de respaldo) ──────
# https://calendarific.com/ — feriados nacionales.
CALENDARIFIC_API_KEY=""
# https://openweathermap.org/api — clima.
OPENWEATHER_API_KEY=""
