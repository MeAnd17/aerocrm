# ── Base de datos (AGENTS.md D2 y D3) ─────────────────────────────────────────
# Conexión de trabajo: pooler de transacciones de Supabase (puerto 6543).
# connection_limit=3 evita que seis máquinas encendidas agoten las conexiones del plan gratuito.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true&connection_limit=3"
# Conexión para aplicar migraciones: pooler de sesión (puerto 5432). Solo la usa quien aplica migraciones (AGENTS.md G4).
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
NODE_ENV="development"
PORT=3000

# External APIs (Mobile CRM)
CALENDARIFIC_API_KEY="your-calendarific-api-key"
OPENWEATHER_API_KEY="your-openweathermap-api-key"
AMADEUS_CLIENT_ID="your-amadeus-client-id"
AMADEUS_CLIENT_SECRET="your-amadeus-client-secret"
AMADEUS_BASE_URL="https://test.api.amadeus.com"
