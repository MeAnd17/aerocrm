# Base compartida (Supabase) con el usuario postgres. Solo para los responsables de integración (AGENTS.md G4).
# Copia este archivo a backend/.env.compartida y reemplaza <CONTRASEÑA> por la contraseña de postgres
# (Supabase > Project Settings > Database). backend/.env.compartida no se versiona.
#
# Lo usan scripts/db-compartida (migrar y cargar) y scripts/db-backup. Tu backend/.env no se toca.
# Escribe la contraseña sin los signos < >. Si tiene símbolos, cada uno va codificado como %XX
# (* es %2A, @ es %40, # es %23, ! es %21, $ es %24, & es %26): sin eso la cadena de conexión no funciona.

# Pooler de transacciones (puerto 6543).
DATABASE_URL="postgresql://postgres.rjlgbxywcmwhqvmgbqtv:<CONTRASEÑA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3"
# Pooler de sesión (puerto 5432): aplica migraciones.
DIRECT_URL="postgresql://postgres.rjlgbxywcmwhqvmgbqtv:<CONTRASEÑA>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
