generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión de trabajo (pooler de Supabase, con connection_limit). AGENTS.md D3.
  url       = env("DATABASE_URL")
  // Conexión directa, solo para aplicar migraciones. AGENTS.md D2 y D3.
  directUrl = env("DIRECT_URL")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  CLIENT
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  firstName          String
  lastName           String
  isActive            Boolean   @default(true)
  role                UserRole  @default(CLIENT)
  mustChangePassword  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client             Client?
  bookings           Booking[]
}

// ─── CLIENT PROFILE ───────────────────────────────────────────────────────────

model Client {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  phone              String?
  nationality        String?
  dateOfBirth        DateTime?
  documentType       DocumentType?
  documentNumber     String?

  // Preferencias opcionales del registro
  travelStyle        TravelStyle?   // SOLO, PAREJA, FAMILIA, GRUPO
  destinationType    DestinationType? // PLAYA, CIUDAD, AVENTURA, CULTURA
  spendingRange      SpendingRange? // LESS_500, RANGE_500_1500, RANGE_1500_3000, MORE_3000

  // Programa de fidelización
  totalPoints        Int       @default(0)
  availablePoints    Int       @default(0)  // puntos canjeables (no usados)
  completedTrips     Int       @default(0)
  membershipLevel    MembershipLevel @default(EXPLORADOR)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelers          Traveler[]
  bookings           Booking[]
  pointsHistory      PointsHistory[]
  savedDestinations  SavedDestination[]
  reviews            Review[]
}

enum TravelStyle {
  SOLO
  PAREJA
  FAMILIA
  GRUPO
}

enum DestinationType {
  PLAYA
  CIUDAD
  AVENTURA
  CULTURA
}

enum SpendingRange {
  LESS_500
  RANGE_500_1500
  RANGE_1500_3000
  MORE_3000
}

enum MembershipLevel {
  EXPLORADOR
  VIAJERO
  FRECUENTE
  ELITE
}

// ─── TRAVELERS (viajeros frecuentes guardados) ────────────────────────────────

model Traveler {
  id             Int          @id @default(autoincrement())
  clientId       Int
  firstName      String
  lastName       String
  documentType   DocumentType @default(DNI)
  documentNumber String
  dateOfBirth    DateTime
  relation       String       // pareja, hijo, padre, etc.
  createdAt      DateTime     @default(now())

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ─── DESTINATIONS ─────────────────────────────────────────────────────────────

model Destination {
  id           Int             @id @default(autoincrement())
  name         String
  country      String
  countryCode  String          // ISO: CO, MX, BR, ES...
  city         String
  iataCode     String          @unique
  description  String?         @db.Text
  imageUrl     String?
  type         DestinationType
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  departingFlights  Flight[] @relation("OriginFlights")
  arrivingFlights   Flight[] @relation("DestinationFlights")
  hotels            Hotel[]
  activities        Activity[]
  festivities       Festivity[]
  savedBy           SavedDestination[]
  climate           DestinationClimate[]
}

// ─── FLIGHTS ──────────────────────────────────────────────────────────────────

model Flight {
  id                  Int      @id @default(autoincrement())
  originId            Int
  destinationId       Int
  airline             String
  flightNumber        String
  departureDate       DateTime
  arrivalDate         DateTime
  durationMinutes     Int
  stops               Int      @default(0)
  classType           FlightClass
  pricePerPerson      Decimal  @db.Decimal(10, 2)
  currency            String   @default("PEN")
  seatsAvailable      Int
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  origin              Destination @relation("OriginFlights", fields: [originId], references: [id])
  destination         Destination @relation("DestinationFlights", fields: [destinationId], references: [id])
  bookingFlights      BookingFlight[]
}

enum FlightClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST_CLASS
}

// ─── HOTELS ───────────────────────────────────────────────────────────────────

model Hotel {
  id            Int      @id @default(autoincrement())
  destinationId Int
  name          String
  stars         Int      // 1-5
  zone          String?
  description   String?  @db.Text
  imageUrl      String?
  pricePerNight Decimal  @db.Decimal(10, 2)
  currency      String   @default("PEN")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  destination   Destination @relation(fields: [destinationId], references: [id])
  bookingHotels BookingHotel[]
}

// ─── ACTIVITIES ───────────────────────────────────────────────────────────────

model Activity {
  id            Int          @id @default(autoincrement())
  destinationId Int
  name          String
  description   String?      @db.Text
  type          ActivityType
  durationHours Int?
  price         Decimal      @db.Decimal(10, 2)
  currency      String       @default("PEN")
  imageUrl      String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  destination        Destination         @relation(fields: [destinationId], references: [id])
  bookingActivities  BookingActivity[]
}

enum ActivityType {
  AVENTURA
  CULTURAL
  GASTRONOMICO
  FAMILIAR
  RELAX
  DEPORTIVO
}

// ─── FESTIVITIES (curadas manualmente) ───────────────────────────────────────

model Festivity {
  id            Int               @id @default(autoincrement())
  destinationId Int
  name          String
  description   String?           @db.Text
  startMonth    Int               // 1-12
  startDay      Int               // 1-31
  endMonth      Int
  endDay        Int
  category      FestivityCategory @default(CULTURAL)
  imageUrl      String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())

  destination   Destination @relation(fields: [destinationId], references: [id])
}

enum FestivityCategory {
  CULTURAL
  RELIGIOSO
  GASTRONOMICO
  MUSICAL
  DEPORTIVO
  CARNAVAL
  NACIONAL
}

// ─── BOOKINGS ─────────────────────────────────────────────────────────────────

model Booking {
  id                String        @id @default(cuid())
  confirmationCode  String        @unique
  userId            Int
  clientId          Int
  status            BookingStatus @default(PENDIENTE)
  totalPrice        Decimal       @db.Decimal(10, 2)
  currency          String        @default("PEN")
  pointsEarned      Int           @default(0)
  pointsUsed        Int           @default(0)
  discountAmount    Decimal       @default(0) @db.Decimal(10, 2)
  passengers        Int           @default(1)
  notes             String?
  statusChangedAt   DateTime?
  statusChangedBy   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  client            Client        @relation(fields: [clientId], references: [id])
  bookingFlights     BookingFlight[]
  bookingHotels      BookingHotel[]
  bookingActivities  BookingActivity[]
  bookingExtras      BookingExtra[]
  bookingPassengers  BookingPassenger[]
  review             Review?
}

enum BookingStatus {
  PENDIENTE
  CONFIRMADO
  EN_CURSO
  COMPLETADO
  CANCELADO
}

model BookingFlight {
  id        Int     @id @default(autoincrement())
  bookingId String
  flightId  Int
  priceSnapshot Decimal @db.Decimal(10, 2)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  flight    Flight  @relation(fields: [flightId], references: [id])
}

model BookingHotel {
  id            Int     @id @default(autoincrement())
  bookingId     String
  hotelId       Int
  checkIn       DateTime
  checkOut      DateTime
  nights        Int
  priceSnapshot Decimal @db.Decimal(10, 2)

  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel         Hotel   @relation(fields: [hotelId], references: [id])
}

model BookingActivity {
  id            Int      @id @default(autoincrement())
  bookingId     String
  activityId    Int
  quantity      Int      @default(1)
  priceSnapshot Decimal  @db.Decimal(10, 2)

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  activity      Activity @relation(fields: [activityId], references: [id])
}

model BookingExtra {
  id        Int        @id @default(autoincrement())
  bookingId String
  type      ExtraType
  price     Decimal    @db.Decimal(10, 2)
  details   String?

  booking   Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingPassenger {
  id             Int          @id @default(autoincrement())
  bookingId      String
  firstName      String
  lastName       String
  documentType   DocumentType @default(DNI)
  documentNumber String
  birthDate      DateTime
  isHolder       Boolean      @default(false)

  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

enum ExtraType {
  TRASLADO_IDA
  TRASLADO_VUELTA
  TRASLADO_COMPLETO
  SEGURO_VIAJE
}

enum DocumentType {
  DNI
  PASAPORTE
}

// ─── POINTS HISTORY ───────────────────────────────────────────────────────────

model PointsHistory {
  id          Int              @id @default(autoincrement())
  clientId    Int
  type        PointsEventType
  points      Int
  description String
  bookingId   String?
  createdAt   DateTime         @default(now())

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum PointsEventType {
  EARNED          // ganados por compra
  REDEEMED        // canjeados como descuento
  EARNED_REFUND   // devuelve puntos ganados al cancelar una reserva confirmada
  REDEEMED_REFUND // devuelve puntos canjeados al cancelar una reserva confirmada
}

// ─── SAVED DESTINATIONS ───────────────────────────────────────────────────────

model SavedDestination {
  id            Int      @id @default(autoincrement())
  clientId      Int
  destinationId Int
  createdAt     DateTime @default(now())

  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@unique([clientId, destinationId])
}

// ─── CONTACT MESSAGES ─────────────────────────────────────────────────────────

enum ContactStatus {
  PENDIENTE
  ATENDIDA
}

model ContactMessage {
  id           Int           @id @default(autoincrement())
  name         String
  email        String
  subject      String
  message      String        @db.Text
  status       ContactStatus @default(PENDIENTE)
  attendedAt   DateTime?
  internalNote String?
  createdAt    DateTime      @default(now())
}

// ─── CATÁLOGO DE EXTRAS (TS-014) ──────────────────────────────────────────────
// Precio de cada extra, para que el paso de extras se calcule en el servidor (AGENTS.md B6).

enum ExtraPricing {
  POR_RESERVA   // un solo cobro por reserva
  POR_PASAJERO  // se multiplica por la cantidad de pasajeros
}

model ExtraOption {
  id          Int          @id @default(autoincrement())
  type        ExtraType    @unique
  name        String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  pricing     ExtraPricing
  currency    String       @default("PEN")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ─── DATOS DE LA AGENCIA (TS-014) ─────────────────────────────────────────────
// Un solo registro (id = 1). Se usa en la confirmación de compra, el detalle imprimible y el pie.

model AgencyInfo {
  id        Int      @id @default(1)
  legalName String
  tradeName String
  ruc       String
  address   String
  phone     String
  email     String
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

// ─── DATOS DE RESPALDO DE APIS EXTERNAS (TS-014) ──────────────────────────────
// Se usan cuando OpenWeatherMap o Calendarific no responden: ninguna pantalla queda en blanco.

model DestinationClimate {
  id            Int         @id @default(autoincrement())
  destinationId Int
  month         Int         // 1-12
  avgTempC      Decimal     @db.Decimal(4, 1)
  minTempC      Decimal     @db.Decimal(4, 1)
  maxTempC      Decimal     @db.Decimal(4, 1)
  rainyDays     Int
  summary       String      // texto corto para la interfaz

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, month])
}

model Holiday {
  id          Int    @id @default(autoincrement())
  countryCode String // ISO: PE, MX, CO...
  month       Int    // 1-12
  day         Int    // 1-31
  name        String

  @@unique([countryCode, month, day])
}

// ─── CACHE DE APIS EXTERNAS (TS-013) ──────────────────────────────────────────
// Guarda la última respuesta exitosa de Calendarific y OpenWeatherMap para no
// consultar el servicio externo en cada visita.  Si la clave externa no está
// configurada se salta el caché y se usa el dato de respaldo de la base.
//
// Claves de ejemplo:
//   "holidays:PE:2026"          → feriados de Perú para 2026 (TTL 30 días)
//   "weather:Lima:2026-12"      → clima de Lima en diciembre de 2026 (TTL 3 h)

model ExternalApiCache {
  id        Int      @id @default(autoincrement())
  cacheKey  String   @unique   // ej: "holidays:PE:2026", "weather:Lima:2026-12"
  data      Json
  fetchedAt DateTime @default(now())
  expiresAt DateTime
}

// ─── REVIEWS (TS-024) ─────────────────────────────────────────────────────────

model Review {
  id          Int      @id @default(autoincrement())
  bookingId   String   @unique
  clientId    Int
  rating      Int      // 1-5
  comment     String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt
  booking     Booking  @relation(fields: [bookingId], references: [id])
  client      Client   @relation(fields: [clientId], references: [id])
}

